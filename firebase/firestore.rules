rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // users/{uid} is created by the verifyOtp Cloud Function.
    // plan / status / email are only changed server-side
    // (RevenueCat webhook, account deletion).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && !changedKeys().hasAny(['plan', 'status', 'email', 'createdAt', 'lastInsightAt', 'recentInsightTopics']);
      allow create, delete: if false;
    }

    match /entries/{entryId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /assets/{assetId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    // Written by the sendNotifications function; the user can only mark as read.
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && changedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // OTP codes are only accessed by Cloud Functions (Admin SDK).
    match /otpCodes/{id} {
      allow read, write: if false;
    }
  }
}
